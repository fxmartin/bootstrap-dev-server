# ABOUTME: Pinned versions of externally sourced tools the bootstrap installs
# ABOUTME: Bump by merge request; re-running the bootstrap converges servers to these values
#
# Plain KEY=value, no spaces around "=", no command substitution: this file is
# sourced by scripts/install-sdlc-controller.sh and parsed by tests/*.bats.

# fxmartin/claude-code-config release tag the sdlc controller is installed from
# (git+https://github.com/fxmartin/claude-code-config@<tag>#subdirectory=controller).
# Same tag = no-op on re-run; a new tag upgrades the installed controller.
SDLC_CONTROLLER_TAG=v2.127.2

# uv-managed interpreter the controller runs on (controller needs >=3.11).
# Never a /nix/store Python: Nix garbage collection would break `sdlc`.
SDLC_CONTROLLER_PYTHON=3.12
